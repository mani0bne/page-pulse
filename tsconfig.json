{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": "./src",
    "outDir": "./dist",

    "strict": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "resolveJsonModule": true,

    "types": ["node"],

    "lib": [
      "ES2022",
      "DOM"
    ],

    "skipLibCheck": true,
    "sourceMap": true
  },
  "include": ["src/**/*"]
}
