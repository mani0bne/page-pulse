{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",

    "rootDir": "./src",
    "outDir": "./dist",

    "strict": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "resolveJsonModule": true,

    "types": ["node"],

    "lib": [
      "ES2022",
      "DOM"
    ],

    "sourceMap": true,

    "skipLibCheck": true,

    "forceConsistentCasingInFileNames": true,

    "removeComments": true,

    "declaration": false
  },

  "include": ["src/**/*"],

  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts"
  ]
}
